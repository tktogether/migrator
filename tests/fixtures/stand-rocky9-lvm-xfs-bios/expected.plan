# reloca.to plan  donor=10.0.2.15/24/XS-Live-OS (QEMU%20Standard%20PC%20(i440FX%20+%20PIIX,%201996)%20SN=XS-STAND-DONOR, Rocky%20Linux%209.8%20(Blue%20Onyx))  recipient=to-XS-456 (QEMU%20Standard%20PC%20(Q35%20+%20ICH9,%202009)%20SN=XS-456, boot=eth0/52:54:00:cc:dd:01)
# inv_sha256=ad99a21ae4230e3d199299140996122c986a73ce14092477ef5206273be1f0a8:030afd0292da5ae3053f60385b00e181e6bfe9eb0b37a77842b423451c016f69  reloca=-  live=-  date=-
# WARN: recipient modalias not checked against the donor kernels (no pci_drivers in the kernel records): drivers virtio_blk,virtio_pci,virtio_net are assumed present
[target]
disk=/dev/vda id=model:- size=960197124096 lsec=512 psec=512 ptuuid=- head=-
currently=free
label=dos firmware=bios bios_grub=- esp=- driver=virtio_blk,virtio_pci,virtio_net data=ssh compress=lz4
[volumes]
# src kind fs size used method target tsize mount num notes  (transfer order: small first, root last)
src=/dev/vda2	kind=pv	fs=lvm	size=11806965760	used=-	method=pv	target=/dev/vda2	tsize=959120932864	mount=-	num=2	notes=elastic
src=/dev/rl/swap	kind=lv	fs=swap	size=1073741824	used=-	method=mkswap	target=/dev/rl/swap	tsize=1073741824	mount=swap	num=-	notes=swap-lv
src=/dev/vda1	kind=part	fs=xfs	size=1073741824	used=253296640	method=block	target=/dev/vda1	tsize=1073741824	mount=/boot	num=1	notes=-
src=/dev/rl/root	kind=lv	fs=xfs	size=10733223936	used=1606537216	method=block	target=/dev/rl/root	tsize=958041948160	mount=/	num=-	notes=100%FREE,grow
[sfdisk]
label: dos
label-id: 7088cb2f
unit: sectors
sector-size: 512
/dev/vda1 : start=2048, size=2097152, type=83, bootable
/dev/vda2 : start=2099200, size=1873283072, type=8e
[lvm]
pvcreate -ff -y --uuid 0VaEs4-syn5-qDW7-Ju0j-2faV-BSMx-B9cR10 --norestorefile /dev/vda2
vgcreate rl /dev/vda2
lvcreate -y -n swap -L 1073741824b rl
lvcreate -y -n root -l 100%FREE rl
[mkfs]
# guard: /dev/vda1 xfs oldest_kernel=5.14.0 needs=SPARSE_INODES:4.2,REFLINK:4.9,INOBTCNT:5.10,BIGTIME:5.10 ok
mkswap -U 283edcc0-d9f8-4254-a185-a70cfdafdb66 /dev/rl/swap
# guard: /dev/rl/root xfs oldest_kernel=5.14.0 needs=SPARSE_INODES:4.2,REFLINK:4.9,INOBTCNT:5.10,BIGTIME:5.10 ok
[identity]
# spec<TAB>keep | -> new spec | remove | + fstab line to add
/dev/mapper/rl-root	keep
UUID=b0070000-0000-4000-8000-0000000000c9	keep
/dev/mapper/rl-swap	keep
resume=/dev/mapper/rl-swap	keep
rd.lvm.lv=rl/root	keep
rd.lvm.lv=rl/swap	keep
root=/dev/mapper/rl-root	keep
[postfix]
family=rhel initramfs=dracut grub=i386-pc bls=1 lvm_devices_file=delete lvm_filter=keep selinux=autorelabel cloudinit=keep os_root=/dev/rl/root boot=/dev/vda1 esp=-
[network]
donor=ens3/-/nm-keyfile target=eth0 mac=52:54:00:cc:dd:01 cmdline=net.ifnames=0%20biosdevname=0 pin=1
pins=eth0:52:54:00:cc:dd:01
[verify]
drivers=virtio_blk,virtio_pci,virtio_net features=/dev/vda1:xfs:versionnum=0xb4b5%2Cfeatures2=0x18a%2Ccompat=0%2Cro_compat=0xd%2Cincompat=0xb%2Clog_incompat=0,/dev/rl/root:xfs:versionnum=0xb4b5%2Cfeatures2=0x18a%2Ccompat=0%2Cro_compat=0xd%2Cincompat=0xb%2Clog_incompat=0 fstab=3 swap=283edcc0-d9f8-4254-a185-a70cfdafdb66 esp=- cmdline_forbid=rd.md.uuid,rd.md=,/dev/md
