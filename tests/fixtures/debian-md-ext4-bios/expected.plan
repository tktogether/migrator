src=/dev/sda2	kind=swap	fs=swap	size=8589934592	used=-	method=mkswap	target=/dev/vda2	tsize=8589934592	mount=swap	num=2	notes=-
src=/dev/md0	kind=md	fs=ext4	size=1072693248	used=134217728	method=block	target=/dev/vda1	tsize=1073741824	mount=/boot	num=1	notes=grow
