# WARN: /dev/sda6 (ext4) is dirty on the donor: block copy with partclone -I, fsck/journal replay on the copy
[target]
disk=/dev/sda id=wwn:0x5000c500b0000009 size=1000204886016 lsec=512 psec=4096 ptuuid=0x99887766 head=-
