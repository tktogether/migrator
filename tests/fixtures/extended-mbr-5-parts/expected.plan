label=gpt firmware=bios bios_grub=128 esp=- driver=ahci,igb data=ssh compress=lz4 pmbr_boot=1
[volumes]
# src kind fs size used method target tsize mount num notes  (transfer order: small first, root last)
src=/dev/sda7	kind=swap	fs=swap	size=8589934592	used=-	method=mkswap	target=/dev/sda3	tsize=8589934592	mount=swap	num=3	notes=renumbered%207->3
