# WARN: partitions are renumbered (physical order on dos): PARTUUID= and /dev/sdaN references are rewritten to UUID=
[target]
disk=/dev/sda id=wwn:0x5000c500b0000009 size=1000204886016 lsec=512 psec=4096 ptuuid=0x99887766 head=-
currently=old-os:"old-mail%20Debian%20GNU/Linux%2010%20(buster)%20mtime=2023-11-15"
label=dos firmware=bios bios_grub=- esp=- driver=ahci,igb data=ssh compress=lz4
[volumes]
# src kind fs size used method target tsize mount num notes  (transfer order: small first, root last)
src=/dev/sda3	kind=swap	fs=swap	size=4294967296	used=-	method=mkswap	target=/dev/sda2	tsize=4294967296	mount=swap	num=2	notes=renumbered%203->2
src=/dev/sda1	kind=part	fs=ext4	size=1073741824	used=209715200	method=block	target=/dev/sda1	tsize=1073741824	mount=/boot	num=1	notes=-
src=/dev/sda2	kind=part	fs=ext4	size=494738079744	used=42949672960	method=block	target=/dev/sda3	tsize=994833334272	mount=/	num=3	notes=elastic,renumbered%202->3,grow
