# reloca.to plan  donor=10.0.2.15/24/XS-Live-OS (QEMU%20Standard%20PC%20(i440FX%20+%20PIIX,%201996)%20SN=XS-STAND-DONOR, Debian%20GNU/Linux%2011%20(bullseye))  recipient=to-XS-456 (QEMU%20Standard%20PC%20(Q35%20+%20ICH9,%202009)%20SN=XS-456, boot=eth0/52:54:00:cc:dd:01)
# inv_sha256=c5fd2db4158f6f57fa4ce01fbb5731fbb5e332d811b320d938b62c69f5d27cfa:8d434ca59f213391c020f0dad2e272928421098907f5f159ca8e09826641a942  reloca=-  live=-  date=-
# WARN: partitions of other donor disks are appended to /dev/vda as extra slots: /dev/vdb2(swap)
# WARN: partitions are renumbered (physical order on dos): PARTUUID= and /dev/vdaN references are rewritten to UUID=
# WARN: recipient modalias not checked against the donor kernels (no pci_drivers in the kernel records): drivers virtio_blk,virtio_pci,virtio_net are assumed present
[target]
disk=/dev/vda id=model:- size=960197124096 lsec=512 psec=512 ptuuid=- head=-
currently=free
label=dos firmware=bios bios_grub=- esp=- driver=virtio_blk,virtio_pci,virtio_net data=ssh compress=lz4
[volumes]
# src kind fs size used method target tsize mount num notes  (transfer order: small first, root last)
src=/dev/vda2	kind=swap	fs=swap	size=2147483648	used=-	method=mkswap	target=/dev/vda2	tsize=2147483648	mount=swap	num=2	notes=-
src=/dev/vdb2	kind=swap	fs=swap	size=2147483648	used=-	method=mkswap	target=/dev/vda3	tsize=2147483648	mount=swap	num=3	notes=from-other-disk,renumbered%202->3
src=/dev/md126	kind=md	fs=ext4	size=1071644672	used=87527424	method=block	target=/dev/vda1	tsize=1073741824	mount=/boot	num=1	notes=grow
src=/dev/md127	kind=md	fs=ext4	size=5362417664	used=908873728	method=block	target=/dev/vda4	tsize=954825965568	mount=/	num=4	notes=elastic,renumbered%203->4,grow
[sfdisk]
label: dos
label-id: 432b9631
unit: sectors
sector-size: 512
/dev/vda1 : start=2048, size=2097152, type=83, bootable
/dev/vda2 : start=2099200, size=4194304, type=82
/dev/vda3 : start=6293504, size=4194304, type=82
/dev/vda4 : start=10487808, size=1864894464, type=83
[lvm]
[mkfs]
# guard: /dev/vda1 ext4 oldest_kernel=5.10.0 needs=none ok
mkswap -U 231753ee-4ef0-48a7-9f6d-19a3e1b26951 -L swap0 /dev/vda2
mkswap -U 129f6d9f-179a-4b12-b100-bc56202e6541 -L swap1 /dev/vda3
# guard: /dev/vda4 ext4 oldest_kernel=5.10.0 needs=none ok
[identity]
# spec<TAB>keep | -> new spec | remove | + fstab line to add
UUID=32431f84-84c8-46b5-bcc0-3e1e93c22618	keep
UUID=766ce09c-da55-4d91-90c5-8b5541a7b3be	keep
UUID=231753ee-4ef0-48a7-9f6d-19a3e1b26951	keep
UUID=129f6d9f-179a-4b12-b100-bc56202e6541	keep
[postfix]
family=deb initramfs=initramfs-tools grub=i386-pc bls=0 lvm_devices_file=keep lvm_filter=keep selinux=none cloudinit=keep os_root=/dev/vda4 boot=/dev/vda1 esp=-
[network]
donor=ens3/-/interfaces target=eth0 mac=52:54:00:cc:dd:01 cmdline=net.ifnames=0%20biosdevname=0 pin=1
pins=eth0:52:54:00:cc:dd:01
[verify]
drivers=virtio_blk,virtio_pci,virtio_net features=/dev/vda1:ext4:features:has_journal%20ext_attr%20resize_inode%20dir_index%20filetype%20extent%2064bit%20flex_bg%20sparse_super%20large_file%20huge_file%20dir_nlink%20extra_isize%20metadata_csum|journal:journal_64bit%20journal_checksum_v3,/dev/vda4:ext4:features:has_journal%20ext_attr%20resize_inode%20dir_index%20filetype%20extent%2064bit%20flex_bg%20sparse_super%20large_file%20huge_file%20dir_nlink%20extra_isize%20metadata_csum|journal:journal_incompat_revoke%20journal_64bit%20journal_checksum_v3 fstab=4 swap=231753ee-4ef0-48a7-9f6d-19a3e1b26951,129f6d9f-179a-4b12-b100-bc56202e6541 esp=- cmdline_forbid=rd.md.uuid,rd.md=,/dev/md
