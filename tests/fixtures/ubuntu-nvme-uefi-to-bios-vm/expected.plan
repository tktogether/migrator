/dev/vda1 : start=4096, size=1048576, type=C12A7328-F81F-11D2-BA4B-00A0C93EC93B, uuid=11111111-aaaa-4bbb-8ccc-000000000001
/dev/vda2 : start=1052672, size=4194304, type=0FC63DAF-8483-4772-8E79-3D69D8477DE4, uuid=11111111-aaaa-4bbb-8ccc-000000000002
/dev/vda3 : start=5246976, size=775999488, type=0FC63DAF-8483-4772-8E79-3D69D8477DE4, uuid=11111111-aaaa-4bbb-8ccc-000000000003
[lvm]
[mkfs]
mkfs.vfat -F32 -i A1B2C3D4 /dev/vda1
# guard: /dev/vda2 ext4 oldest_kernel=5.15.0 needs=none ok
mkfs.ext4 -F -U 6b7c8d9e-0f1a-4b2c-9d3e-4f5a6b7c8d9e -b 4096 -I 256 -N 31088640 -O none,has_journal,ext_attr,resize_inode,dir_index,filetype,extent,64bit,flex_bg,sparse_super,large_file,huge_file,dir_nlink,extra_isize,metadata_csum /dev/vda3
# guard: /dev/vda3 ext4 oldest_kernel=5.15.0 needs=none ok
[identity]
# spec<TAB>keep | -> new spec | remove | + fstab line to add
UUID=6b7c8d9e-0f1a-4b2c-9d3e-4f5a6b7c8d9e	keep
UUID=5a6b7c8d-9e0f-4a1b-8c2d-3e4f5a6b7c8d	keep
UUID=A1B2-C3D4	keep
/swapfile	keep
[postfix]
family=deb initramfs=initramfs-tools grub=i386-pc bls=0 lvm_devices_file=keep lvm_filter=keep selinux=none cloudinit=disable os_root=/dev/vda3 boot=/dev/vda2 esp=/dev/vda1
[network]
