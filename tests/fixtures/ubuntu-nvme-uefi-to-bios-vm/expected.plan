# WARN: firmware change uefi -> bios: grub for bios is installed from the Live (grub_from_live=1); afterwards on the donor OS: apt install grub-pc and purge the other
# WARN: donor ESP /dev/nvme0n1p1 is kept as a slot on the bios recipient (harmless, /boot/efi stays in fstab)
# WARN: recipient modalias not checked against the donor kernels (no pci_drivers in the kernel records): drivers virtio_blk,virtio_pci,virtio_net are assumed present
[target]
disk=/dev/vda id=model:- size=400000000000 lsec=512 psec=512 ptuuid=- head=-
currently=free
label=gpt firmware=bios bios_grub=128 esp=1 driver=virtio_blk,virtio_pci,virtio_net data=ssh compress=lz4 pmbr_boot=1 grub_from_live=1
[volumes]
# src kind fs size used method target tsize mount num notes  (transfer order: small first, root last)
src=/dev/nvme0n1p1	kind=esp	fs=vfat	size=535805952	used=6291456	method=esp	target=/dev/vda1	tsize=536870912	mount=/boot/efi	num=1	notes=-
src=/dev/nvme0n1p2	kind=part	fs=ext4	size=2147483648	used=314572800	method=block	target=/dev/vda2	tsize=2147483648	mount=/boot	num=2	notes=-
src=/dev/nvme0n1p3	kind=part	fs=ext4	size=509424435200	used=128849018880	method=files	target=/dev/vda3	tsize=397311737856	mount=/	num=3	notes=elastic
