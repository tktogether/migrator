# inv_sha256=f99f59c73860bfe344477e2f23408618c6e1ddbe90ffe0b8b007405a91631a01:6bf69a3790e8ce96e4bcfc4f842fbbf2bf45e2c6af4e9631ab0933e0e109a290  reloca=-  live=-  date=-
# WARN: recipient modalias not checked against the donor kernels (no pci_drivers in the kernel records): drivers virtio_blk,virtio_pci,virtio_net are assumed present
[target]
disk=/dev/vda id=serial:XSRECIP0 size=21474836480 lsec=512 psec=512 ptuuid=- head=-
currently=free
label=gpt firmware=uefi bios_grub=- esp=1 driver=virtio_blk,virtio_pci,virtio_net data=ssh compress=lz4
[volumes]
# src kind fs size used method target tsize mount num notes  (transfer order: small first, root last)
src=/dev/vda3	kind=pv	fs=lvm	size=11177820160	used=-	method=pv	target=/dev/vda3	tsize=19769851904	mount=-	num=3	notes=elastic
src=/dev/vda1	kind=esp	fs=vfat	size=629145600	used=-	method=esp	target=/dev/vda1	tsize=629145600	mount=/boot/efi	num=1	notes=-
src=/dev/rl/swap	kind=lv	fs=swap	size=1073741824	used=-	method=mkswap	target=/dev/rl/swap	tsize=1073741824	mount=swap	num=-	notes=swap-lv
src=/dev/vda2	kind=part	fs=xfs	size=1073741824	used=246095872	method=block	target=/dev/vda2	tsize=1073741824	mount=/boot	num=2	notes=-
src=/dev/rl/root	kind=lv	fs=xfs	size=10104078336	used=1674514432	method=block	target=/dev/rl/root	tsize=18689818624	mount=/	num=-	notes=100%FREE,grow
[sfdisk]
label: gpt
label-id: b32300d0-9580-470d-8ab9-d033b6d53e43
unit: sectors
sector-size: 512
/dev/vda1 : start=2048, size=1228800, type=C12A7328-F81F-11D2-BA4B-00A0C93EC93B, uuid=935491f9-f633-4586-b879-e2f15a51a95b, name="EFI System Partition"
/dev/vda2 : start=1230848, size=2097152, type=0FC63DAF-8483-4772-8E79-3D69D8477DE4, uuid=1a6c1242-0d21-492f-9dee-0c01aa406a1d
/dev/vda3 : start=3328000, size=38612992, type=E6D6D379-F507-44C2-A23C-238F2A3DF928, uuid=06619c5a-8d40-4c64-a4a3-1a96dcc86832
[lvm]
pvcreate -ff -y --uuid ItANx0-FzqY-zntm-Yf57-ZtBV-Vg99-7cuUIP --norestorefile /dev/vda3
vgcreate rl /dev/vda3
lvcreate -y -n swap -L 1073741824b rl
lvcreate -y -n root -l 100%FREE rl
[mkfs]
mkfs.vfat -F32 -i C0DE0E5E /dev/vda1
# guard: /dev/vda2 xfs oldest_kernel=5.14.0 needs=SPARSE_INODES:4.2,REFLINK:4.9,INOBTCNT:5.10,BIGTIME:5.10 ok
mkswap -U 17c91f53-d022-48a1-9077-62635d5ac70c /dev/rl/swap
# guard: /dev/rl/root xfs oldest_kernel=5.14.0 needs=SPARSE_INODES:4.2,REFLINK:4.9,INOBTCNT:5.10,BIGTIME:5.10 ok
[identity]
# spec<TAB>keep | -> new spec | remove | + fstab line to add
/dev/mapper/rl-root	keep
UUID=b0070000-0000-4000-8000-0000000000c9	keep
UUID=C0DE-0E5E	keep
/dev/mapper/rl-swap	keep
resume=/dev/mapper/rl-swap	keep
rd.lvm.lv=rl/root	keep
rd.lvm.lv=rl/swap	keep
root=/dev/mapper/rl-root	keep
[postfix]
family=rhel initramfs=dracut grub=x86_64-efi bls=1 lvm_devices_file=delete lvm_filter=keep selinux=autorelabel cloudinit=keep os_root=/dev/rl/root boot=/dev/vda2 esp=/dev/vda1
[network]
donor=ens3/-/nm-keyfile target=eth0 mac=52:54:00:cc:dd:01 cmdline=net.ifnames=0%20biosdevname=0 pin=1
pins=eth0:52:54:00:cc:dd:01
[verify]
drivers=virtio_blk,virtio_pci,virtio_net features=/dev/vda2:xfs:versionnum=0xb4b5%2Cfeatures2=0x18a%2Ccompat=0%2Cro_compat=0xd%2Cincompat=0xb%2Clog_incompat=0,/dev/rl/root:xfs:versionnum=0xb4b5%2Cfeatures2=0x18a%2Ccompat=0%2Cro_compat=0xd%2Cincompat=0xb%2Clog_incompat=0 fstab=4 swap=17c91f53-d022-48a1-9077-62635d5ac70c esp=/dev/vda1 cmdline_forbid=rd.md.uuid,rd.md=,/dev/md
