# reloca.to plan  donor=10.0.2.15/24/XS-Live-OS (QEMU%20Standard%20PC%20(i440FX%20+%20PIIX,%201996)%20SN=XS-STAND-DONOR, Debian%20GNU/Linux%2012%20(bookworm))  recipient=to-XS-2 (QEMU%20Standard%20PC%20(i440FX%20+%20PIIX,%201996)%20SN=XS-STAND-RECIP, boot=eth0/52:54:00:cc:dd:01)
# inv_sha256=bd87ed547217923ac4f018f08a3520d5a23dfb361da5339c840c778fa9439313:f0f6e30ec65e09cb843a91a3d3955047640d9db9f13398ec8dfabd0f9e6f802a  reloca=-  live=-  date=-
# WARN: raid=1: /dev/vda + /dev/vdb become md RAID1 pairs per slot, ESP/bios_grub on both disks, the resync runs in the background after the copy
# WARN: raid=1: the filesystems live on md arrays, not on partitions: PARTUUID= references are rewritten to UUID=
# WARN: recipient modalias not checked against the donor kernels (no pci_drivers in the kernel records): drivers virtio_blk,virtio_pci,virtio_net are assumed present
[target]
disk=/dev/vda id=serial:XSRECIP0 size=21474836480 lsec=512 psec=512 ptuuid=- head=-
currently=free
label=gpt firmware=uefi bios_grub=- esp=1 driver=virtio_blk,virtio_pci,virtio_net data=ssh compress=lz4 raid=1
disk2=/dev/vdb id2=serial:XSRECIP1 size2=21474836480 ptuuid2=- head2=- geometry=21474836480 md=/dev/md2,/dev/md3 esp2=/dev/vdb1
currently2=free
[volumes]
# src kind fs size used method target tsize mount num notes  (transfer order: small first, root last)
src=/dev/vda3	kind=pv	fs=lvm	size=9122611200	used=-	method=pv	target=/dev/md3	tsize=19845349376	mount=-	num=3	notes=elastic,raid1
src=/dev/vda1	kind=esp	fs=vfat	size=536870912	used=-	method=esp	target=/dev/vda1	tsize=536870912	mount=/boot/efi	num=1	notes=-
src=-	kind=esp	fs=vfat	size=536870912	used=-	method=esp	target=/dev/vdb1	tsize=536870912	mount=-	num=1	notes=esp-mirror
src=/dev/vg0/swap	kind=lv	fs=swap	size=1073741824	used=-	method=mkswap	target=/dev/vg0/swap	tsize=1073741824	mount=swap	num=-	notes=swap-lv
src=/dev/vda2	kind=part	fs=ext4	size=1073741824	used=114298880	method=block	target=/dev/md2	tsize=1073741824	mount=/boot	num=2	notes=raid1
src=/dev/vg0/root	kind=lv	fs=xfs	size=8048869376	used=1027010560	method=block	target=/dev/vg0/root	tsize=18765316096	mount=/	num=-	notes=100%FREE,grow
[sfdisk]
label: gpt
label-id: 7a1e2d3c-4b5a-4968-8776-655443322110
unit: sectors
sector-size: 512
/dev/vda1 : start=2048, size=1048576, type=C12A7328-F81F-11D2-BA4B-00A0C93EC93B, uuid=7a1e2d3c-0001-4000-8000-000000000001, name="EFI System Partition"
/dev/vda2 : start=1050624, size=2113536, type=0FC63DAF-8483-4772-8E79-3D69D8477DE4, uuid=7a1e2d3c-0002-4000-8000-000000000002
/dev/vda3 : start=3164160, size=38776832, type=E6D6D379-F507-44C2-A23C-238F2A3DF928, uuid=7a1e2d3c-0003-4000-8000-000000000003
[sfdisk2]
label: gpt
label-id: BC0506F8-9A72-E9F2-9124-BAA8568CEFBA
unit: sectors
sector-size: 512
/dev/vdb1 : start=2048, size=1048576, type=C12A7328-F81F-11D2-BA4B-00A0C93EC93B, uuid=B47602CA-FE90-8C5F-9186-181949646DDD, name="EFI System Partition"
/dev/vdb2 : start=1050624, size=2113536, type=0FC63DAF-8483-4772-8E79-3D69D8477DE4, uuid=2F4AE868-A68C-DFEA-67FB-FD74CDC27CAB
/dev/vdb3 : start=3164160, size=38776832, type=E6D6D379-F507-44C2-A23C-238F2A3DF928, uuid=863B8F93-98E3-FE5D-D438-12F795F66B49
[md]
# one array per data slot, members = the same partition number on both disks; an array is its slot minus 8M
mdadm --create /dev/md2 --run --level=1 --raid-devices=2 --metadata=1.2 --data-offset=8M --homehost=fixture-uefi --name=2 --uuid=96dd27f3:b16e8465:3d6be6ab:afc910c6 /dev/vda2 /dev/vdb2
mdadm --create /dev/md3 --run --level=1 --raid-devices=2 --metadata=1.2 --data-offset=8M --homehost=fixture-uefi --name=3 --uuid=c51245b4:e891e3a6:e871d7eb:77d6c850 /dev/vda3 /dev/vdb3
[lvm]
pvcreate -ff -y --uuid fxPV00-uefi-Lvm2-Xfs0-Gpt0-Esp0-000001 --norestorefile /dev/md3
vgcreate vg0 /dev/md3
lvcreate -y -n swap -L 1073741824b vg0
lvcreate -y -n root -l 100%FREE vg0
[mkfs]
mkfs.vfat -F32 -i C0DE0E5F -n EFI /dev/vda1
mkfs.vfat -F32 -i C0DE0E5F -n EFI /dev/vdb1
# guard: /dev/md2 ext4 oldest_kernel=6.1.0 needs=none ok
mkswap -U 5a5a0000-0eaf-4a1c-8000-000000000004 -L swap /dev/vg0/swap
# guard: /dev/vg0/root xfs oldest_kernel=6.1.0 needs=SPARSE_INODES:4.2,REFLINK:4.9,INOBTCNT:5.10,BIGTIME:5.10 ok
[identity]
# spec<TAB>keep | -> new spec | remove | + fstab line to add
/dev/mapper/vg0-root	keep
UUID=b0070000-e4f4-4b00-8000-000000000002	keep
UUID=C0DE-0E5F	keep
/dev/mapper/vg0-swap	keep
[postfix]
family=deb initramfs=initramfs-tools grub=x86_64-efi bls=0 lvm_devices_file=keep lvm_filter=keep selinux=none cloudinit=keep os_root=/dev/vg0/root boot=/dev/md2 esp=/dev/vda1 raid=1 disk2=/dev/vdb esp2=/dev/vdb1 mdadm=-
[network]
donor=ens3/-/networkd target=eth0 mac=52:54:00:cc:dd:01 cmdline=net.ifnames=0%20biosdevname=0 pin=1
pins=eth0:52:54:00:cc:dd:01
[verify]
drivers=virtio_blk,virtio_pci,virtio_net features=/dev/md2:ext4:features:has_journal%20ext_attr%20resize_inode%20dir_index%20filetype%20extent%2064bit%20flex_bg%20sparse_super%20large_file%20huge_file%20dir_nlink%20extra_isize%20metadata_csum|journal:journal_incompat_revoke%20journal_64bit%20journal_checksum_v3,/dev/vg0/root:xfs:versionnum=0xb4b5%2Cfeatures2=0x18a%2Ccompat=0%2Cro_compat=0xd%2Cincompat=0xb%2Clog_incompat=0 fstab=4 swap=5a5a0000-0eaf-4a1c-8000-000000000004 esp=/dev/vda1 cmdline_forbid=rd.md.uuid,rd.md=,/dev/md md=/dev/md2,/dev/md3 esp2=/dev/vdb1
