# migrator plan  donor=10.0.0.12/24/web1 (Supermicro%20X11SSH-F%20SN=S123456, Debian%20GNU/Linux%2011%20(bullseye))  recipient=to-XS-456 (QEMU%20Standard%20PC%20(Q35%20+%20ICH9,%202009)%20SN=XS-456, boot=eth0/52:54:00:cc:dd:01)
# inv_sha256=cfcd465f2b6b0eddeaf13e7a229fdb5ef4e1784a7524678d9a46bc5ee830d6c8:d26c7760686ab69b2e7d59a1b3e31ff51f176c66bd0299c79f12b65b9a79cf90  migrator=-  live=-  date=-
# WARN: raid=1: /dev/vda + /dev/vdb become md RAID1 pairs per slot, ESP/bios_grub on both disks, the resync runs in the background after the copy (the donor's 2 md array(s) keep their UUIDs)
# WARN: raid=1: the filesystems live on md arrays, not on partitions: PARTUUID= references are rewritten to UUID=
[target]
disk=/dev/vda id=model:- size=960197124096 lsec=512 psec=512 ptuuid=- head=-
currently=free
label=dos firmware=bios bios_grub=- esp=- driver=virtio_blk,virtio_pci,virtio_net data=ssh compress=lz4 raid=1
disk2=/dev/vdb id2=model:- size2=960197124096 ptuuid2=- head2=- geometry=960197124096 md=/dev/md1,/dev/md2,/dev/md3 esp2=-
currently2=free
[volumes]
# src kind fs size used method target tsize mount num notes  (transfer order: small first, root last)
src=/dev/sda2	kind=swap	fs=swap	size=8589934592	used=-	method=mkswap	target=/dev/md2	tsize=8589934592	mount=swap	num=2	notes=raid1
src=/dev/md0	kind=md	fs=ext4	size=1072693248	used=134217728	method=block	target=/dev/md1	tsize=1073741824	mount=/boot	num=1	notes=raid1,grow
src=/dev/md1	kind=md	fs=ext4	size=990404673536	used=442381631488	method=files	target=/dev/md3	tsize=950505832448	mount=/	num=3	notes=elastic,raid1
[sfdisk]
label: dos
label-id: 0x5c3f1a2b
unit: sectors
sector-size: 512
/dev/vda1 : start=2048, size=2113536, type=83, bootable
/dev/vda2 : start=2115584, size=16793600, type=82
/dev/vda3 : start=18909184, size=1856473088, type=83
[sfdisk2]
label: dos
label-id: 0x170b5b47
unit: sectors
sector-size: 512
/dev/vdb1 : start=2048, size=2113536, type=83, bootable
/dev/vdb2 : start=2115584, size=16793600, type=82
/dev/vdb3 : start=18909184, size=1856473088, type=83
[md]
# one array per data slot, members = the same partition number on both disks; an array is its slot minus 8M
mdadm --create /dev/md1 --run --level=1 --raid-devices=2 --metadata=1.2 --data-offset=8M --homehost=web1 --name=1 --uuid=1f2e3d4c:5b6a7988:9a0b1c2d:3e4f5a6b /dev/vda1 /dev/vdb1
mdadm --create /dev/md2 --run --level=1 --raid-devices=2 --metadata=1.2 --data-offset=8M --homehost=web1 --name=2 --uuid=8cdd67b2:a490888e:139944df:c3e3bdd9 /dev/vda2 /dev/vdb2
mdadm --create /dev/md3 --run --level=1 --raid-devices=2 --metadata=1.2 --data-offset=8M --homehost=web1 --name=3 --uuid=7a8b9c0d:1e2f3a4b:5c6d7e8f:9a0b1c2e /dev/vda3 /dev/vdb3
[lvm]
[mkfs]
# guard: /dev/md1 ext4 oldest_kernel=5.10.0 needs=none ok
mkswap -U 3c4d5e6f-3333-4a2b-9c1d-7e8f9a0b1c02 /dev/md2
mkfs.ext4 -F -U 0d9e8f7a-2222-4b1c-8a3d-5e6f7a8b9c01 -b 4096 -I 256 -N 60456960 -O none,has_journal,ext_attr,resize_inode,dir_index,filetype,extent,64bit,flex_bg,sparse_super,large_file,huge_file,dir_nlink,extra_isize,metadata_csum /dev/md3
# guard: /dev/md3 ext4 oldest_kernel=5.10.0 needs=none ok
[identity]
# spec<TAB>keep | -> new spec | remove | + fstab line to add
UUID=0d9e8f7a-2222-4b1c-8a3d-5e6f7a8b9c01	keep
/dev/md0	-> UUID=6f1c9e2a-1111-4c3b-9d2e-0a1b2c3d4e50
UUID=3c4d5e6f-3333-4a2b-9c1d-7e8f9a0b1c02	keep
[postfix]
family=deb initramfs=initramfs-tools grub=i386-pc bls=0 lvm_devices_file=keep lvm_filter=keep selinux=none cloudinit=keep os_root=/dev/md3 boot=/dev/md1 esp=- raid=1 disk2=/dev/vdb esp2=- mdadm=-
[network]
donor=ens3/52:54:00:aa:bb:01/interfaces target=eth0 mac=52:54:00:cc:dd:01 cmdline=net.ifnames=0%20biosdevname=0 pin=1
pins=eth0:52:54:00:cc:dd:01
[verify]
drivers=virtio_blk,virtio_pci,virtio_net features=/dev/md1:ext4:features:has_journal%20ext_attr%20resize_inode%20dir_index%20filetype%20extent%2064bit%20flex_bg%20sparse_super%20large_file%20huge_file%20dir_nlink%20extra_isize%20metadata_csum|journal:journal_64bit%20journal_checksum_v3,/dev/md3:ext4:features:has_journal%20ext_attr%20resize_inode%20dir_index%20filetype%20extent%2064bit%20flex_bg%20sparse_super%20large_file%20huge_file%20dir_nlink%20extra_isize%20metadata_csum|journal:journal_64bit%20journal_checksum_v3 fstab=3 swap=3c4d5e6f-3333-4a2b-9c1d-7e8f9a0b1c02 esp=- cmdline_forbid=rd.md.uuid,rd.md=,/dev/md md=/dev/md1,/dev/md2,/dev/md3 esp2=-
