# core.autocrlf=true on the Windows workstation would otherwise check the
# shell scripts out with CRLF, which bash on the target rejects at the
# shebang (the reason every upload needed sed 's/\r$//').  Pin them to LF.
*.sh            text eol=lf
bin/migrator    text eol=lf
VERSION         text eol=lf
lib/VERSION     text eol=lf
*.md            text eol=lf
*.c             text eol=lf
*.h             text eol=lf
*.yml           text eol=lf
Makefile        text eol=lf
agent/Makefile  text eol=lf
LICENSE*        text eol=lf
NOTICE          text eol=lf
debian/**       text eol=lf
# 'git archive' is how the upstream tarball for the distribution package is
# made; it must not carry debian/, which belongs to the packaging.
debian          export-ignore
