#!/bin/bash
# reloca.to — move a Linux server from a donor machine onto this one (the
# recipient) over the network, both booted into the XServer Live OS. Replaces
# the manual runbook: inventory both sides, write a plan you can read and edit,
# partition and format the recipient, stream every filesystem, fix the copy up
# in a chroot (fstab, initramfs drivers, grub, network), verify it boots, and
# only then cut over. The donor is never written to.
#
# usage: reloca.to [-n] [-y] [-i KEYFILE] [-d DISK] [-s STEP] [-o key=value]... [DONOR] [ARG]
#   DONOR         [root@]host[:port] of the source: booted into the Live (off-line relocation,
#                 source.reloca.to) or running its own OS (on-line relocation: the volumes are
#                 copied in passes by reloca-agent while it runs and frozen for the last delta;
#                 the mode is detected, -o mode=online|offline insists on one)
#   (no -s)       the whole migration: bootstrap -> inventory -> plan -> check -> confirm
#                 -> apply -> transfer -> postfix -> verify -> confirm -> cutover
#   -s STEP       one step only (idempotent, skips what is done):
#                   plan DONOR        read-only: inventory both sides, write $RUN/plan, summary
#                   check [PLAN]      re-validate a (hand-edited) plan
#                   apply | transfer | postfix [ROOT] | verify [ROOT] | cutover
#                   inventory [DONOR] raw records of this box (or of DONOR)
#                   attach            back to the running tmux session (or tail the log)
#                   cleanup           undo mounts/activations/read-only marks reloca.to left behind
#   -d DISK       target disk on this box when it has several (/dev/sda, /dev/nvme0n1,
#                 /dev/disk/by-id/...); default: the only eligible disk, else a refusal listing them.
#                 -d DISK,DISK2 with -o raid=1: mirror the two (md RAID1 per slot, grub/ESP on both)
#   -n   dry run: print every command, change nothing      -y   never ask (answers yes)
#   -i KEYFILE    ssh key for the source                    -V   version
#   -o key=value  repeat it for every key ("-o compress=none -o patience=600"):
#                  a comma belongs to the value (driver=mod1,mod2,
#                  console=ttyS0,115200), so options are never joined by one.
#                  Every key is listed at https://reloca.to/options/; an unknown
#                  key is refused, so a typo cannot silently do nothing
#      both modes: root=auto|block|files label=auto|gpt|dos nic=eth0 donor-nic=IFACE
#         nic-pin=1|0 driver=MOD console=... redo=N cloudinit=disable|keep bootorder=pxe|local
#         boottest=1|0 (verify boots a qcow2 overlay of the target disk in qemu and asserts
#            the system reaches multi-user on a serial console; needs qemu-system-x86,
#            installed on demand; target disk is never written)
#         fsck=quick|full boot-part=SIZE cutover=netdown|poweroff|kexec|none offline=1
#         expect=SERIAL|MAC force=1 raw=DIR cipher=aes128-gcm@openssh.com mode=online|offline
#         relay=USER@HOST[:SSHPORT] (E2: the donor forwards :22/:2222 onto the relay via
#            tools/relay-tunnel.sh; pass the relay as DONOR "USER@RELAY:2222" with
#            -o sshd-port=2223; this box forwards its cutover port back via the relay)
#         raid=1 (two identical disks on this box: md RAID1 pairs; -d DISK,DISK2 names them, or the only two)
#         compress=auto|zstd[:LEVEL]|lz4|none  on-line: each data frame is compressed on the
#            donor and auto (the default) picks the level from the measured donor cpu and link
#            speed; off-line: the stream compressor, lz4 by default
#      off-line only: data=ssh|raw sshd-port=2222 watchdog=15
#      on-line only: chunk=64K passes=8 converge=10 max-est=100 tracker=auto|bpf|ftrace
#         stall=300 (silence from the donor that counts as a wedged path) settle=1000
#         precheck=1|0 (default 1: before the real cutover, run postfix and verify on a
#            snapshot of the copy while the donor runs on) precheck-dir=DIR precheck-cow=SIZE
#         patience=1800  seconds of extra copying worth trading for a shorter freeze; the agent
#            measures how fast the donor writes and how fast the link carries, says how many
#            passes and minutes a shorter freeze would cost, and stops at this budget
#         verify-hash=1 (sha256 of every frozen volume against the copy) cutover-port=2223
#   long forms: --dry-run --yes --key K --disk D --step S --option k=v --version --help
# exit: 0 ok · 1 runtime failure · 2 usage/environment/identity · 3 verify failed
#       (disk written, do NOT reboot) · 4 plan infeasible or edited plan rejected
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

HERE=$(dirname "$(readlink -f "$0")")
if [ -r "$HERE/../lib/common.sh" ]; then RELOCA_LIB=$(readlink -f "$HERE/../lib"); else RELOCA_LIB=/usr/local/lib/reloca.to; fi
export RELOCA_LIB
RUN=${RUN:-/run/reloca.to}; export RUN
DRY=; YES=; SSH_KEYFILE=; DISK=auto; STEP=
declare -A OPT
usage() { awk 'NR > 1 && !/^#/ { exit } NR > 1 { sub(/^# ?/, ""); print }' "$0"; exit "${1:-2}"; }
# long options are rewritten to the short ones getopts knows
ARGS=()
while [ $# -gt 0 ]; do
	case $1 in
		--dry-run) ARGS+=(-n) ;; --yes) ARGS+=(-y) ;; --version) ARGS+=(-V) ;; --help) ARGS+=(-h) ;;
		--key|--disk|--step|--option) [ $# -ge 2 ] || { echo "$1 needs a value" >&2; exit 2; }
			case $1 in --key) ARGS+=(-i "$2");; --disk) ARGS+=(-d "$2");; --step) ARGS+=(-s "$2");; --option) ARGS+=(-o "$2");; esac; shift ;;
		--key=*|--disk=*|--step=*|--option=*) v=${1#*=}; case $1 in --key=*) ARGS+=(-i "$v");; --disk=*) ARGS+=(-d "$v");; --step=*) ARGS+=(-s "$v");; --option=*) ARGS+=(-o "$v");; esac ;;
		--) shift; ARGS+=("$@"); break ;;
		--*) echo "unknown option $1" >&2; usage 2 ;;
		*) ARGS+=("$1") ;;
	esac
	shift
done
set -- "${ARGS[@]}"
while getopts "nyi:d:s:o:Vh" o; do
	case $o in
		n) DRY=y ;; y) YES=y ;; i) SSH_KEYFILE=$OPTARG ;; d) DISK=$OPTARG ;; s) STEP=$OPTARG ;;
		o) case $OPTARG in *=*) OPTKEY=${OPTARG%%=*}; OPT[${OPTKEY//_/-}]=${OPTARG#*=} ;; *) echo "bad -o $OPTARG (want key=value)" >&2; exit 2 ;; esac ;;
		V) STEP=version ;; h) usage 0 ;; *) usage 2 ;;
	esac
done
shift $((OPTIND-1))
CMD=${STEP:-all}
case $CMD in all|plan|check|apply|transfer|postfix|verify|cutover|inventory|attach|cleanup|version) ;;
	*) echo "unknown step: $CMD" >&2; usage 2 ;; esac
[ "$CMD" != all ] && [ "$CMD" != plan ] || [ -n "${1:-}" ] || { echo "DONOR is required: reloca.to [-s plan] [root@]host[:port]" >&2; usage 2; }
# A dry run must not leave state, keys or a lock that a real run would trip
# over: the steps that PRODUCE files (plan, all, inventory) work in $RUN/dry.
# The other steps only read under -n ("-n -s postfix" = show the diffs of a
# real plan/transfer), so they look at the real $RUN first and fall back to dry.
if [ -n "$DRY" ]; then
	case $CMD in
		plan|all|inventory) RUN=$RUN/dry ;;
		*) [ -r "$RUN/plan" ] || [ ! -r "$RUN/dry/plan" ] || RUN=$RUN/dry ;;
	esac
fi
export DRY YES RUN
# shellcheck source=lib/common.sh
. "$RELOCA_LIB/common.sh"
opt_check
for f in ssh bootstrap inventory plan apply transfer target postfix netfix verify; do
	# shellcheck disable=SC1090  # the libs are known, listed just above
	[ -r "$RELOCA_LIB/$f.sh" ] && . "$RELOCA_LIB/$f.sh"
done

# --- identity: who is who, printed on every line ------------------------------
# lie, so that is refused.
# The two Lives are named by ROLE, not by serial: this box becomes
# destination.reloca.to, the donor source.reloca.to (transient hostnames, gone
# with the Live). No argument, nothing to confuse: the shell prompt, the log
# tag and "+ donor:" lines say which side a command ran on. The identity of
# the machines is still checked (nonce, DMI, MAC) in ssh_guard_same_box.
HOST_TO=destination.reloca.to; HOST_FROM=source.reloca.to
set_roles() {
	ROLE_TAG=destination; export ROLE_TAG
	# only a Live gets renamed: "reloca.to -s check" on the build host must not touch it
	if [ -z "$DRY" ] && [ -n "$(live_release_file)" ] && have hostnamectl; then
		hostnamectl --transient set-hostname "$HOST_TO" 2>/dev/null || true
	fi
}

# --- tmux: the transfer must outlive the operator's ssh session ----------------
# Long phases re-exec themselves inside a tmux session named "reloca.to"; a
# dropped connection then costs nothing and "reloca.to -s attach" comes back.
# An unattended run (-y, no terminal) needs no tmux.
# The pane runs a wrapper that records the inner exit code and keeps the pane
# open on failure: tmux itself always exits 0 and would otherwise swallow both
# the code and the reason line. "=reloca.to" is an exact session name (a bare
# name is a prefix match). The flock fd must be closed before the re-exec or
# the inner instance finds its own lock held by the tmux client.
maybe_tmux() {
	[ -z "$DRY" ] && [ -z "$YES" ] && is_tty && [ -z "${TMUX:-}" ] || return 0
	have tmux || { warn "tmux not available: running in the foreground, a dropped ssh session will kill the transfer"; return 0; }
	if tmux has-session -t =reloca.to 2>/dev/null; then
		say "a reloca.to tmux session already exists, attaching to it"
		unlock; exec tmux attach -t =reloca.to
	fi
	say "re-launching inside tmux session 'reloca.to' (detach: Ctrl-B D, return: reloca.to -s attach)"
	local inner wrapper rc
	inner=$(printf '%q ' "$0" "${ORIG_ARGS[@]}")
	wrapper="$inner; rc=\$?; echo \$rc > $(printf '%q' "$RUN/tmux.rc"); [ \$rc -eq 0 ] || read -rp '[reloca.to] exit '\$rc' - see $(printf '%q' "$RUN/log"), press Enter to close '; exit \$rc"
	rm -f "$RUN/tmux.rc"; unlock
	tmux new-session -s reloca.to "bash -c $(printf '%q' "$wrapper")"
	rc=$(cat "$RUN/tmux.rc" 2>/dev/null || echo 1)
	exit "$rc"
}
ORIG_ARGS=("$@")
# rebuild the original flag set for the tmux re-exec
_flags=(); [ -n "$DRY" ] && _flags+=(-n); [ -n "$YES" ] && _flags+=(-y)
[ -n "$SSH_KEYFILE" ] && _flags+=(-i "$SSH_KEYFILE"); [ "$DISK" = auto ] || _flags+=(-d "$DISK")
[ -z "$STEP" ] || _flags+=(-s "$STEP")
for k in "${!OPT[@]}"; do _flags+=(-o "$k=${OPT[$k]}"); done
ORIG_ARGS=("${_flags[@]}" "$@")

# --- the phases (M1+ fill these in; until then they say so and stop) -----------
phase() { PHASE=$1; say "=== $1 ==="; }
not_yet() { die "$EX_FAIL" "phase '$PHASE' is not implemented yet ($1)"; }
stub_or() { if declare -f "$1" >/dev/null; then "$1" "${@:3}"; else not_yet "$2"; fi; }

connect_donor() {   # $1 = DONOR
	local want found
	phase connect
	ssh_connect "$1"                       # master + auth chain + session key
	# off-line (the donor is a Live) or on-line (the donor runs its own OS): detected,
	# -o mode= only insists; recorded so every later phase knows which one this is
	want=$(opt mode); found=$(ssh_donor_mode)
	case $want in
		'') ;;
		online|offline) [ "$want" = "$found" ] || die "$EX_ENV" "mode=$want but the donor $DONOR_HOST $([ "$found" = online ] && echo 'runs its own OS (on-line relocation)' || echo 'is a Live (off-line relocation)'): $([ "$want" = offline ] && echo 'boot it into the Live first' || echo 'mode=online wants the running OS, not the Live')";;
		*) die "$EX_ENV" "bad -o mode=$want (want online or offline)";;
	esac
	RELOCA_MODE=$found; export RELOCA_MODE; state_set mode "$found"
	ssh_relay_start
	if [ "$found" = online ]; then
		ssh_require_online_donor
		ssh_guard_same_box
		# the donor is somebody's production: no rename, no apt, no second sshd; the agent lives on a tmpfs
		say "on-line relocation: donor $DONOR_HOST ($(ssh_donor_serial)) keeps running its OS, this box is $HOST_TO"
		bootstrap_donor_online
		phase_done bootstrap
		return 0
	fi
	ssh_require_full_live_donor
	ssh_guard_same_box
	# rrun: echoed as "+ donor:" (a runbook line), printed only as "(dry) donor:" under -n
	rrun hostnamectl --transient set-hostname "$HOST_FROM" 2>/dev/null || true
	say "donor $DONOR_HOST ($(ssh_donor_serial)) is now $HOST_FROM, this box is $HOST_TO"
	bootstrap_donor
	ssh_start_data_sshd
	phase_done bootstrap
}
# reconnect_donor: phases run as separate commands (apply, transfer, postfix)
# find the donor in the state connect_donor left behind
reconnect_donor() {
	local d; d=$(state_get donor.target)
	[ -n "$d" ] || die "$EX_ENV" "no donor recorded in $RUN/state: run 'reloca.to -s plan DONOR' first"
	connect_donor "$d"
}

cmd_all() {
	local donor=$1 disk=$DISK
	lock; phase bootstrap; bootstrap_local; maybe_tmux
	connect_donor "$donor"
	phase inventory;  stub_or inventory_run M1 both
	phase plan;       stub_or plan_build M1 "$disk"
	phase check;      stub_or plan_check M1
	family_gate
	phase apply;      stub_or apply_run M2
	phase transfer;   stub_or transfer_run M2
	phase postfix;    stub_or postfix_run M3
	phase verify;     stub_or verify_run M3
	phase cutover;    stub_or cutover_run M3 "$(opt cutover netdown)"
}
# Only a family postfix knows gets past here, before apply: nothing is written
# yet. The same spot fetches what postfix will need from the mirror (the grub
# packages for a firmware change on deb, grub_from_live=1): a mirror outage must
# fail BEFORE the disk is written, not after a two-hour transfer. rhel fetches
# nothing here: its grub2 packages come from the target's own repositories by
# dnf in the chroot ([postfix] grub_pkgs=), and that can only run once the OS is on the disk.
family_gate() {
	local fam; fam=$(plan_get "$RUN/plan" postfix family 2>/dev/null)
	case $fam in
		deb|rhel) ;;
		*) die "$EX_PLAN" "unsupported donor family '$fam' (nothing was written)" ;;
	esac
	if [ "$(plan_get "$RUN/plan" target grub_from_live 2>/dev/null)" = 1 ] && declare -f bootstrap_local >/dev/null; then
		say "firmware change: fetching the grub packages into the Live now, before anything is written"
		bootstrap_local grub
	fi
}
cmd_plan() {
	local donor=$1 disk=$DISK
	lock; phase bootstrap; bootstrap_local
	connect_donor "$donor"
	phase inventory;  stub_or inventory_run M1 both
	phase plan;       stub_or plan_build M1 "$disk"
}
# inventory [DONOR]: the raw records (docs/format.md) of this box, or of the
# donor; what plan reads, and how fixtures are captured (-o raw=DIR).
cmd_inventory() {
	set_roles
	if [ -n "$1" ]; then
		connect_donor "$1"; phase inventory; stub_or inventory_run M1 donor
		cat "$RUN/donor.inv"
	else
		phase inventory; stub_or inventory_run M1 recipient
		cat "$RUN/recipient.inv"
	fi
}
cmd_attach() {
	if have tmux && tmux has-session -t =reloca.to 2>/dev/null; then exec tmux attach -t =reloca.to; fi
	say "no tmux session; state:"; cat "$RUN/state" 2>/dev/null || echo "  (none)"
	[ -r "$RUN/log" ] && exec tail -n 40 -f "$RUN/log"
	die "$EX_ENV" "nothing to attach to"
}
cmd_cleanup() { set_roles; stub_or cleanup_all M2; }
cmd_version() {
	echo "reloca.to $(reloca_version)  lib=$RELOCA_LIB  live=${LIVE_ID:-$(live_build_id)}"
}

case $CMD in
	all)        require_full_live; cmd_all "$@" ;;
	plan)       require_full_live; cmd_plan "$@" ;;
	check)      set_roles; phase check;    stub_or plan_check M1 "$@" ;;
	apply)      require_full_live; lock; set_roles; maybe_tmux; family_gate; phase apply; stub_or apply_run M2 ;;
	transfer)   require_full_live; lock; set_roles; maybe_tmux; reconnect_donor; phase transfer; stub_or transfer_run M2 ;;
	postfix)    require_full_live; lock; set_roles; maybe_tmux; phase postfix;  stub_or postfix_run M3 "$@" ;;
	verify)     require_full_live; set_roles; phase verify;   stub_or verify_run M3 "$@" ;;
	cutover)    require_full_live; lock; set_roles; phase cutover;  stub_or cutover_run M3 "$(opt cutover netdown)" ;;
	attach)     cmd_attach ;;
	cleanup)    require_full_live; cmd_cleanup ;;
	inventory)  require_full_live; cmd_inventory "$@" ;;
	version)    cmd_version ;;
esac
